# Synthetic placeholders only; never loaded by the offline CLI.
# The explicit live entry requires your own provider/data/cost confirmations and budget.
CHAT_BASE_URL=https://provider.example.invalid/v1
CHAT_MODEL=REVIEWED_MODEL_ID
CHAT_API_KEY=LOCAL_SECRET_PLACEHOLDER

# Daily research email, optional. links-only is the default. full-report
# includes the verified full text inline and requires fresh owner consent for
# both the digest and each included watch. Does not start research.
# ETF_DAILY_DIGEST_CONTENT=links-only

# Separate full HTML + exact Markdown emails per explicitly consented Watch.
# Requires verified SMTP config and an authenticated HTTPS reader origin.
# Mutually exclusive with ETF_DAILY_DIGEST_ENABLED=1.
# ETF_DAILY_WATCH_EMAIL_CONTENT=text
# ETF_DAILY_WATCH_EMAIL_OWNER_ORIGIN=
